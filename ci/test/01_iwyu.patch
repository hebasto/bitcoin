Prefer angled brackets over quotes for include directives.
See: https://en.cppreference.com/w/cpp/preprocessor/include.html.

--- a/iwyu_path_util.cc
+++ b/iwyu_path_util.cc
@@ -224,9 +224,9 @@ bool IsQuotedInclude(StringRef s) {
 string AddQuotes(StringRef include_name, bool angled) {
   string res;
   res.reserve(include_name.size() + 2);
-  res.push_back(angled ? '<' : '"');
+  res.push_back('<');
   res.append(include_name);
-  res.push_back(angled ? '>' : '"');
+  res.push_back('>');
   return res;
 }
 
